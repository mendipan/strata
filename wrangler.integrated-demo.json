{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "strata-integrated-demo-disabled",
  "main": "src/integrated-demo-worker-entry.ts",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
