[Unit]
Description=Strata Studio development read-only host
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/strata-studio/current
ExecStart=/opt/strata-studio/node/bin/node --max-old-space-size=128 dist/scripts/studio-host.js --host-config /etc/strata-studio/host.json
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
StateDirectory=strata-studio
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
MemoryMax=192M
CPUQuota=50%
TasksMax=32
LimitNOFILE=256
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
