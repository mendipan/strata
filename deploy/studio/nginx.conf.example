# Owner-adapted example. Provision TLS and exact proxy/client restrictions on
# your gateway before enabling this listener. Keep existing sites unchanged.
server {
    listen 127.0.0.1:8080;
    server_name studio.example.test;
    access_log off;
    error_log /var/log/nginx/strata-studio.error.log warn;
    client_max_body_size 1k;
    # Shared proxy restrictions are inherited by every location below.
    proxy_http_version 1.1;
    proxy_set_header Host studio.example.test;
    # Set https only when the ingress actually enforces the owner's HTTPS
    # origin. An HTTP listener alone is not proof of TLS or identity.
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host "";
    proxy_set_header X-Forwarded-For "";
    proxy_set_header X-Real-IP "";
    proxy_set_header Forwarded "";
    proxy_set_header Connection "";
    proxy_connect_timeout 2s;
    proxy_read_timeout 12s;
    proxy_send_timeout 12s;
    proxy_no_cache 1;
    proxy_cache_bypass 1;
    # These two authoring routes already have a 1 MiB application bound.
    # The default remains 1 KiB for other routes. This is an example only;
    # adapting it to a live origin requires separate deployment approval.
    location = /studio/v1/preview {
        client_max_body_size 1m;
        proxy_pass http://127.0.0.1:4174;
    }
    location = /studio/v1/operation {
        client_max_body_size 1m;
        proxy_pass http://127.0.0.1:4174;
    }
    # Bounded agent requests, including explicit owner service setup. These
    # routes inherit every proxy/header restriction above. The application
    # enforces its tighter per-route limits; runner pairing is outward HTTPS.
    location ~ ^/studio/v1/(owner/(agents(/|$)|agent-)|agent-runners/) {
        client_max_body_size 128k;
        proxy_pass http://127.0.0.1:4174;
        proxy_read_timeout 120s;
        proxy_send_timeout 30s;
    }
    location / {
        proxy_pass http://127.0.0.1:4174;
    }
}
