        "status": {
          "maxItems": 5000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 240
              },
              "staged": {
                "type": "boolean"
              },
              "unstaged": {
                "type": "boolean"
              },
              "untracked": {
                "type": "boolean"
              }
            },
            "required": [
              "path",
              "staged",
              "unstaged",
              "untracked"
            ],
            "additionalProperties": false
          }
        },
        "outside_scope_dirty": {
          "type": "boolean"
        },
        "ignored_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        },
        "excluded_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        },
        "unsupported": {
          "maxItems": 256,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
