            "additionalProperties": false
          }
        },
        "coherence": {
          "type": "string",
          "enum": [
            "stable",
            "changed-during-read"
          ]
        },
        "trust": {
          "type": "string",
          "enum": [
            "local-measurement",
            "imported-snapshot"
          ]
        }
      },
      "required": [
        "format",
        "project_id",
        "repo_id",
        "object_format",
        "head_commit",
        "head_tree",
        "index_sha256",
        "scope_sha256",
        "entries",
        "manifest_sha256",
        "status",
        "outside_scope_dirty",
        "ignored_count",
        "excluded_count",
        "unsupported",
        "coherence",
        "trust"
      ],
      "additionalProperties": false
