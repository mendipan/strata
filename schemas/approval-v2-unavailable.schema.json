{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "approval/2"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*$"
    },
    "model_version": {
      "type": "string",
      "const": "strata/0.2-content-mediation-experimental"
    },
    "baseline": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
    },
    "authority_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "resolution",
        "scope",
        "guardian",
        "release"
      ]
    },
    "target": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scope": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "generation": {
      "type": "string",
      "minLength": 1
    },
    "expires_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "binding": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "basis_ref": {
              "type": "string"
            },
            "packet_ref": {
              "type": "string"
            },
            "case_revision": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "option_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "partition_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "receipt_ref": {
              "type": "string"
            }
          },
          "required": [
            "basis_ref",
            "packet_ref",
            "case_revision",
            "option_id",
            "partition_sha256",
            "receipt_ref"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "format",
    "project_id",
    "model_version",
    "baseline",
    "authority_sha256",
    "kind",
    "target",
    "scope",
    "evidence_digest",
    "generation",
    "expires_at",
    "binding"
  ],
  "additionalProperties": false
}
