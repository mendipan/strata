{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "validation/3"
    },
    "candidate": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "target": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
    },
    "realization": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
    },
    "evidence": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "const": "strata-host-evidence/1"
        },
        "candidate": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "realization": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
        },
        "profile": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "output_tree": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "checker_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "fixture_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "oracle_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "producer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "run_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
        },
        "results": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "check": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "fixture": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "method": {
                "type": "string",
                "enum": [
                  "mechanical",
                  "review"
                ]
              },
              "passed": {
                "type": "boolean"
              },
              "reviewer": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "review_ref": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "check",
              "version",
              "fixture",
              "method",
              "passed",
              "reviewer",
              "review_ref"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "format",
        "candidate",
        "realization",
        "profile",
        "output_tree",
        "checker_sha256",
        "fixture_sha256",
        "oracle_sha256",
        "producer",
        "run_ref",
        "results"
      ],
      "additionalProperties": false
    },
    "evidence_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "auth_receipt": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
    },
    "trust": {
      "type": "string",
      "const": "host-measured"
    }
  },
  "required": [
    "format",
    "candidate",
    "target",
    "realization",
    "evidence",
    "evidence_digest",
    "auth_receipt",
    "trust"
  ],
  "additionalProperties": false
}
