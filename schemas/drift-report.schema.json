{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "source-drift-report/1"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "repo_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "binding_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
    },
    "binding_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "observed_intent": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
        },
        "record_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "candidate_fingerprint": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "ref",
        "record_sha256",
        "snapshot_sha256",
        "candidate_fingerprint"
      ],
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "const": "git-observation/1"
        },
        "project_id": {
          "type": "string",
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*$"
        },
        "repo_id": {
          "type": "string",
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*$"
        },
        "object_format": {
          "type": "string",
          "enum": [
            "sha1",
            "sha256"
          ]
        },
        "head_commit": {
          "type": "string"
        },
        "head_tree": {
          "type": "string"
        },
        "index_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scope_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "entries": {
          "maxItems": 256,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 240
              },
              "presence": {
                "type": "string",
                "enum": [
                  "present",
                  "absent"
                ]
              },
              "kind": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "regular",
                      "symlink",
                      "gitlink"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "mode": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "100644",
                      "100755",
                      "120000",
                      "160000"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "byte_length": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4194304
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "path",
              "presence",
              "kind",
              "mode",
              "byte_length",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "maxItems": 5000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 240
              },
              "staged": {
                "type": "boolean"
              },
              "unstaged": {
                "type": "boolean"
              },
              "untracked": {
                "type": "boolean"
              }
            },
            "required": [
              "path",
              "staged",
              "unstaged",
              "untracked"
            ],
            "additionalProperties": false
          }
        },
        "outside_scope_dirty": {
          "type": "boolean"
        },
        "ignored_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        },
        "excluded_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        },
        "unsupported": {
          "maxItems": 256,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 240
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "required": [
              "path",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "coherence": {
          "type": "string",
          "enum": [
            "stable",
            "changed-during-read"
          ]
        },
        "trust": {
          "type": "string",
          "enum": [
            "local-measurement",
            "imported-snapshot"
          ]
        }
      },
      "required": [
        "format",
        "project_id",
        "repo_id",
        "object_format",
        "head_commit",
        "head_tree",
        "index_sha256",
        "scope_sha256",
        "entries",
        "manifest_sha256",
        "status",
        "outside_scope_dirty",
        "ignored_count",
        "excluded_count",
        "unsupported",
        "coherence",
        "trust"
      ],
      "additionalProperties": false
    },
    "observation_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidence": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
          },
          "record_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "application",
              "profile-only"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "compatible-pass",
              "compatible-fail",
              "incomplete",
              "mismatched",
              "profile-only"
            ]
          },
          "trust": {
            "type": "string",
            "enum": [
              "local-fixture-import",
              "local-fixed-fixture",
              "profile-fixture"
            ]
          },
          "execution_authenticated": {
            "type": "boolean",
            "const": false
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "limitations": {
            "maxItems": 256,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        },
        "required": [
          "ref",
          "record_sha256",
          "kind",
          "state",
          "trust",
          "execution_authenticated",
          "criteria",
          "limitations"
        ],
        "additionalProperties": false
      }
    },
    "evidence_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_changes": {
      "maxItems": 768,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "kind": {
            "type": "string",
            "enum": [
              "added",
              "deleted",
              "bytes-changed",
              "mode-changed",
              "kind-changed"
            ]
          },
          "before": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "maxLength": 240
                  },
                  "presence": {
                    "type": "string",
                    "enum": [
                      "present",
                      "absent"
                    ]
                  },
                  "kind": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "regular",
                          "symlink",
                          "gitlink"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "mode": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "100644",
                          "100755",
                          "120000",
                          "160000"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "byte_length": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4194304
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "sha256": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "path",
                  "presence",
                  "kind",
                  "mode",
                  "byte_length",
                  "sha256"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "after": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "maxLength": 240
                  },
                  "presence": {
                    "type": "string",
                    "enum": [
                      "present",
                      "absent"
                    ]
                  },
                  "kind": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "regular",
                          "symlink",
                          "gitlink"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "mode": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "100644",
                          "100755",
                          "120000",
                          "160000"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "byte_length": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4194304
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "sha256": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "path",
                  "presence",
                  "kind",
                  "mode",
                  "byte_length",
                  "sha256"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "path",
          "kind",
          "before",
          "after"
        ],
        "additionalProperties": false
      }
    },
    "possible_renames": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "deleted": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "added": {
            "maxItems": 256,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "ambiguous": {
            "type": "boolean"
          }
        },
        "required": [
          "deleted",
          "added",
          "ambiguous"
        ],
        "additionalProperties": false
      }
    },
    "acceptance_changes": {
      "maxItems": 1024,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterion_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "before_evidence_ref": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
          },
          "after_evidence_ref": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
          },
          "before_passed": {
            "type": "boolean"
          },
          "after_passed": {
            "type": "boolean"
          },
          "kind": {
            "type": "string",
            "enum": [
              "reported-outcome-change",
              "demonstrated-fixture-outcome-change",
              "incomparable"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "criterion_ref",
          "before_evidence_ref",
          "after_evidence_ref",
          "before_passed",
          "after_passed",
          "kind",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "intent_changes": {
      "maxItems": 1024,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "before_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "after_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "normative",
              "explanatory",
              "topology"
            ]
          }
        },
        "required": [
          "item",
          "before_sha256",
          "after_sha256",
          "category"
        ],
        "additionalProperties": false
      }
    },
    "intent_record_changed": {
      "type": "boolean"
    },
    "head_changed": {
      "type": "boolean"
    },
    "index_status_changed": {
      "type": "boolean"
    },
    "coverage": {
      "type": "object",
      "properties": {
        "scope_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scope_complete": {
          "type": "boolean"
        },
        "acceptance_complete": {
          "type": "boolean"
        },
        "missing_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "unmapped_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "missing_items": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      },
      "required": [
        "scope_sha256",
        "scope_complete",
        "acceptance_complete",
        "missing_paths",
        "unmapped_paths",
        "missing_items",
        "criteria",
        "exclusions"
      ],
      "additionalProperties": false
    },
    "behavior_status": {
      "type": "string",
      "enum": [
        "unknown",
        "reported-compatible-results",
        "bounded-fixture-results",
        "reported-outcome-change",
        "demonstrated-fixture-outcome-change"
      ]
    },
    "assessment": {
      "type": "string",
      "enum": [
        "no-source-delta",
        "attention",
        "blocked"
      ]
    },
    "blockers": {
      "maxItems": 512,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "limitations": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "producer": {
      "type": "object",
      "properties": {
        "principal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "trust": {
          "type": "string",
          "enum": [
            "local-measurement",
            "imported-snapshot"
          ]
        }
      },
      "required": [
        "principal",
        "trust"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "format",
    "project_id",
    "repo_id",
    "binding_ref",
    "binding_sha256",
    "observed_intent",
    "observation",
    "observation_sha256",
    "evidence",
    "evidence_sha256",
    "source_changes",
    "possible_renames",
    "acceptance_changes",
    "intent_changes",
    "intent_record_changed",
    "head_changed",
    "index_status_changed",
    "coverage",
    "behavior_status",
    "assessment",
    "blockers",
    "limitations",
    "producer"
  ],
  "additionalProperties": false
}
