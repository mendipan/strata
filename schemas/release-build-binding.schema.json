{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "strata-release-build-binding/1"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]{0,255}$"
    },
    "repository_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]{0,255}$"
    },
    "release": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "ref",
        "sha256"
      ],
      "additionalProperties": false
    },
    "contract": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "ref",
        "sha256"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "string",
      "const": "post_publication_adoption"
    },
    "author": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]{0,255}$"
    },
    "auth_receipt": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "ref",
        "sha256"
      ],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "ref",
        "sha256"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "format",
    "project_id",
    "repository_id",
    "release",
    "contract",
    "provenance",
    "author",
    "auth_receipt",
    "review"
  ],
  "additionalProperties": false
}
