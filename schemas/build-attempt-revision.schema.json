          "required": [
            "format",
            "project_id",
            "repository_id",
            "selection",
            "source_generation",
            "release",
            "composition",
            "validation",
            "approvals",
            "publication_closure",
            "source_trust",
            "contract",
            "binding",
            "profile",
            "candidate",
