              "maxLength": 512,
              "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "ref",
            "sha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "writer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "action": {
      "type": "string",
      "enum": [
        "build.start",
        "build.reconcile"
