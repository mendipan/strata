                              "pattern": "^[A-Za-z0-9_.-]+\\/[1-9][0-9]*$"
                            },
                            "archive_sha256": {
                              "type": "string",
                              "pattern": "^[a-f0-9]{64}$"
                            }
                          },
                          "required": [
                            "id",
                            "archive_sha256"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "id",
                        "revision",
                        "name",
                        "contract_ref",
                        "contract_sha256",
                        "choices",
                        "materializer"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "normalized_sha256": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "checks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
