                "contract_ref": {
                  "type": "string",
                  "maxLength": 512,
                  "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
                },
                "contract_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "target_ref": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 512,
                      "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
