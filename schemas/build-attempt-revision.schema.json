              "name": {
                "type": "string",
                "maxLength": 128
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4194304
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
