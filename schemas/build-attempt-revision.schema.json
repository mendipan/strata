                              "maxLength": 512,
                              "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
                            },
                            "sha256": {
                              "type": "string",
                              "pattern": "^[a-f0-9]{64}$"
                            },
