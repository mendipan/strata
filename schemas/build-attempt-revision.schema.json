{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "strata-build-attempt-revision/1"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
