        "request_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "request_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]{0,255}$"
        },
        "repository_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]{0,255}$"
        },
        "actor": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]{0,255}$"
        },
        "plan_sha256": {
