                            "runtime": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 128,
                              "pattern": "^[a-z0-9][a-z0-9._-]*$"
                            }
                          },
                          "required": [
                            "language",
                            "framework",
                            "runtime"
                          ],
                          "additionalProperties": false
