{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "criterion-review/1"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "model_version": {
      "type": "string",
      "const": "strata/0.3-block-lifecycle-experimental"
    },
    "candidate": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "realization": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
    },
    "profile": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "output_tree": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "checker_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fixture_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "oracle_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "criterion": {
      "type": "object",
      "properties": {
        "check": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "fixture": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "method": {
          "type": "string",
          "const": "review"
        }
      },
      "required": [
        "check",
        "version",
        "fixture",
        "method"
      ],
      "additionalProperties": false
    },
    "accepted": {
      "type": "boolean"
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "reviewer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "auth_receipt": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
    },
    "trust": {
      "type": "string",
      "const": "host-authenticated"
    }
  },
  "required": [
    "format",
    "project_id",
    "model_version",
    "candidate",
    "realization",
    "profile",
    "output_tree",
    "checker_sha256",
    "fixture_sha256",
    "oracle_sha256",
    "criterion",
    "accepted",
    "rationale",
    "reviewer",
    "auth_receipt",
    "trust"
  ],
  "additionalProperties": false
}
