{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "resolution/3"
    },
    "layer": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
    },
    "proposal_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "payload": {},
    "approvals": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
      }
    },
    "sealed_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "trust": {
      "type": "string",
      "const": "host-authenticated"
    },
    "auth_receipt": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
    }
  },
  "required": [
    "format",
    "layer",
    "proposal_index",
    "payload",
    "approvals",
    "sealed_by",
    "trust",
    "auth_receipt"
  ],
  "additionalProperties": false
}
