{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "reconciliation-producer-descriptor/1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "checker": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "fixture_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "oracle_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "sha256",
        "fixture_sha256",
        "oracle_sha256"
      ],
      "additionalProperties": false
    },
    "oracle": {
      "$ref": "#/$defs/__schema0"
    },
    "assets": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "media_type": {
            "type": "string",
            "enum": [
              "text/javascript",
              "application/json",
              "text/plain"
            ]
          },
          "byte_length": {
            "type": "integer",
            "minimum": 0,
            "maximum": 524288
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes_base64": {
            "type": "string",
            "maxLength": 699052
          }
        },
        "required": [
          "role",
          "media_type",
          "byte_length",
          "sha256",
          "bytes_base64"
        ],
        "additionalProperties": false
      }
    },
    "bounds": {
      "type": "object",
      "properties": {
        "milliseconds": {
          "type": "number",
          "const": 5000
        },
        "old_generation_mib": {
          "type": "number",
          "const": 64
        },
        "young_generation_mib": {
          "type": "number",
          "const": 16
        },
        "ipc_bytes": {
          "type": "number",
          "const": 262144
        }
      },
      "required": [
        "milliseconds",
        "old_generation_mib",
        "young_generation_mib",
        "ipc_bytes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "format",
    "id",
    "version",
    "checker",
    "oracle",
    "assets",
    "bounds"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
