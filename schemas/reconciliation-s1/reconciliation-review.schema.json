{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "reconciliation-review/2"
    },
    "subject": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "const": "reconciliation-approval-subject/2"
        },
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "repo_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "plan": {
          "type": "object",
          "properties": {
            "ref": {
              "type": "string",
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "ref",
            "sha256"
          ],
          "additionalProperties": false
        },
        "plan_body_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "evidence": {
          "type": "object",
          "properties": {
            "ref": {
              "type": "string",
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "ref",
            "sha256"
          ],
          "additionalProperties": false
        },
        "target": {
          "type": "object",
          "properties": {
            "release_ref": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
            },
            "release_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "snapshot_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "model_version": {
              "type": "string",
              "const": "strata/0.1-facets-experimental"
            },
            "candidate_fingerprint": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "release_ref",
            "release_sha256",
            "snapshot_sha256",
            "model_version",
            "candidate_fingerprint"
          ],
          "additionalProperties": false
        },
        "desired_tree_oid": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "contract_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "required_roles": {
          "maxItems": 256,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:release|source:[A-Za-z0-9_.-]+|scope:[A-Za-z0-9_.-]+|guardian:[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+)$"
          }
        },
        "successor_template": {
          "type": "object",
          "properties": {
            "predecessor": {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string",
                  "maxLength": 256,
                  "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "ref",
                "sha256"
              ],
              "additionalProperties": false
            },
            "target": {
              "type": "object",
              "properties": {
                "release_ref": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
                },
                "release_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "snapshot_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "model_version": {
                  "type": "string",
                  "const": "strata/0.1-facets-experimental"
                },
                "candidate_fingerprint": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "release_ref",
                "release_sha256",
                "snapshot_sha256",
                "model_version",
                "candidate_fingerprint"
              ],
              "additionalProperties": false
            },
            "scope": {
              "type": "object",
              "properties": {
                "format": {
                  "type": "string",
                  "const": "source-scope/1"
                },
                "coverage": {
                  "type": "string",
                  "const": "selected-scope"
                },
                "paths": {
                  "maxItems": 256,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 240
                  }
                },
                "watch_roots": {
                  "maxItems": 64,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 240
                  }
                },
                "exclusions": {
                  "maxItems": 256,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "maxLength": 240
                      },
                      "kind": {
                        "type": "string",
                        "enum": [
                          "file",
                          "directory"
                        ]
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      }
                    },
                    "required": [
                      "path",
                      "kind",
                      "reason"
                    ],
                    "additionalProperties": false
                  }
                },
                "items": {
                  "minItems": 1,
                  "maxItems": 256,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "mapping": {
                  "minItems": 1,
                  "maxItems": 256,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "item": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      },
                      "paths": {
                        "minItems": 1,
                        "maxItems": 256,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "maxLength": 240
                        }
                      },
                      "criteria": {
                        "maxItems": 256,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 4096
                        }
                      }
                    },
                    "required": [
                      "item",
                      "paths",
                      "criteria"
                    ],
                    "additionalProperties": false
                  }
                },
                "limitations": {
                  "maxItems": 256,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                }
              },
              "required": [
                "format",
                "coverage",
                "paths",
                "watch_roots",
                "exclusions",
                "items",
                "mapping",
                "limitations"
              ],
              "additionalProperties": false
            },
            "desired_tree_oid": {
              "type": "string",
              "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
            },
            "desired_manifest_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "limitations": {
              "maxItems": 256,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "allowed_transition": {
              "type": "string",
              "const": "reviewed-clean-head-or-single-child"
            },
            "evidence_policy": {
              "type": "string",
              "const": "fresh-same-contract-and-source"
            },
            "required_roles": {
              "maxItems": 256,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(?:release|source:[A-Za-z0-9_.-]+|scope:[A-Za-z0-9_.-]+|guardian:[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+)$"
              }
            }
          },
          "required": [
            "predecessor",
            "target",
            "scope",
            "desired_tree_oid",
            "desired_manifest_sha256",
            "limitations",
            "allowed_transition",
            "evidence_policy",
            "required_roles"
          ],
          "additionalProperties": false
        },
        "historical_bridge": {
          "type": "object",
          "properties": {
            "predecessor": {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string",
                  "maxLength": 256,
                  "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "ref",
                "sha256"
              ],
              "additionalProperties": false
            },
            "old_intent": {
              "type": "object",
              "properties": {
                "release_ref": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
                },
                "release_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "snapshot_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "model_version": {
                  "type": "string",
                  "const": "strata/0.1-facets-experimental"
                }
              },
              "required": [
                "release_ref",
                "release_sha256",
                "snapshot_sha256",
                "model_version"
              ],
              "additionalProperties": false
            },
            "target": {
              "type": "object",
              "properties": {
                "release_ref": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
                },
                "release_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "snapshot_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "model_version": {
                  "type": "string",
                  "const": "strata/0.1-facets-experimental"
                },
                "candidate_fingerprint": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "release_ref",
                "release_sha256",
                "snapshot_sha256",
                "model_version",
                "candidate_fingerprint"
              ],
              "additionalProperties": false
            },
            "target_release_trust": {
              "type": "string",
              "const": "local-fixture"
            },
            "predecessor_validation": {
              "type": "string",
              "enum": [
                "validated",
                "accepted-unvalidated-bootstrap"
              ]
            },
            "target_validation": {
              "type": "string",
              "const": "validated"
            },
            "semantic_records": {
              "maxItems": 16384,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "release",
                      "composition",
                      "layer",
                      "resolution",
                      "realization",
                      "validation",
                      "approval"
                    ]
                  },
                  "pin": {
                    "type": "object",
                    "properties": {
                      "ref": {
                        "type": "string",
                        "maxLength": 256,
                        "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    },
                    "required": [
                      "ref",
                      "sha256"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "type",
                  "pin"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "predecessor",
            "old_intent",
            "target",
            "target_release_trust",
            "predecessor_validation",
            "target_validation",
            "semantic_records"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "format",
        "project_id",
        "repo_id",
        "plan",
        "plan_body_sha256",
        "evidence",
        "target",
        "desired_tree_oid",
        "contract_sha256",
        "required_roles",
        "successor_template",
        "historical_bridge"
      ],
      "additionalProperties": false
    },
    "subject_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "auth": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "ref",
        "sha256"
      ],
      "additionalProperties": false
    },
    "roles": {
      "minItems": 1,
      "maxItems": 256,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?:release|source:[A-Za-z0-9_.-]+|scope:[A-Za-z0-9_.-]+|guardian:[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+)$"
      }
    },
    "accepted": {
      "type": "boolean",
      "const": true
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "valid_until": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "format",
    "subject",
    "subject_sha256",
    "actor",
    "auth",
    "roles",
    "accepted",
    "rationale",
    "valid_until"
  ],
  "additionalProperties": false
}
