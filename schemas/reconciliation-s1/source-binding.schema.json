{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "source-binding/2"
    },
    "payload": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "const": "source-binding-payload/2"
        },
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "repo_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "intent": {
          "type": "object",
          "properties": {
            "release_ref": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
            },
            "release_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "snapshot_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "model_version": {
              "type": "string",
              "const": "strata/0.1-facets-experimental"
            }
          },
          "required": [
            "release_ref",
            "release_sha256",
            "snapshot_sha256",
            "model_version"
          ],
          "additionalProperties": false
        },
        "source": {
          "type": "object",
          "properties": {
            "ref": {
              "type": "string",
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "ref",
            "sha256"
          ],
          "additionalProperties": false
        },
        "predecessor": {
          "type": "object",
          "properties": {
            "ref": {
              "type": "string",
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "ref",
            "sha256"
          ],
          "additionalProperties": false
        },
        "basis": {
          "type": "string",
          "const": "authenticated-reconciliation-association"
        },
        "evidence": {
          "minItems": 1,
          "maxItems": 256,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "ref",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "limitations": {
          "maxItems": 256,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      },
      "required": [
        "format",
        "project_id",
        "repo_id",
        "intent",
        "source",
        "predecessor",
        "basis",
        "evidence",
        "limitations"
      ],
      "additionalProperties": false
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "acceptance": {
      "type": "object",
      "properties": {
        "trust": {
          "type": "string",
          "const": "host-authenticated"
        },
        "completion": {
          "type": "object",
          "properties": {
            "ref": {
              "type": "string",
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "ref",
            "sha256"
          ],
          "additionalProperties": false
        },
        "source_approval": {
          "type": "object",
          "properties": {
            "ref": {
              "type": "string",
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "ref",
            "sha256"
          ],
          "additionalProperties": false
        },
        "finalizer_auth": {
          "type": "object",
          "properties": {
            "ref": {
              "type": "string",
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "ref",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "trust",
        "completion",
        "source_approval",
        "finalizer_auth"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "format",
    "payload",
    "payload_sha256",
    "acceptance"
  ],
  "additionalProperties": false
}
