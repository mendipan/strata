{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "git-application-observation/1"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "repo_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "plan_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
    },
    "stage_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
    },
    "target": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
        },
        "record_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "candidate_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "ref",
        "record_sha256",
        "candidate_fingerprint",
        "snapshot_sha256"
      ],
      "additionalProperties": false
    },
    "base_source_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
    },
    "result_tree_oid": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "result_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "acceptance_contract_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "checker": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "fixture_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "oracle_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "sha256",
        "fixture_sha256",
        "oracle_sha256"
      ],
      "additionalProperties": false
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterion_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "check": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "fixture": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "method": {
            "type": "string",
            "enum": [
              "mechanical",
              "review"
            ]
          },
          "passed": {
            "type": "boolean"
          },
          "reviewer": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "criterion_ref",
          "check",
          "version",
          "fixture",
          "method",
          "passed",
          "reviewer"
        ],
        "additionalProperties": false
      }
    },
    "regressions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "passed": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "passed"
        ],
        "additionalProperties": false
      }
    },
    "producer": {
      "type": "object",
      "properties": {
        "principal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "trust": {
          "type": "string",
          "enum": [
            "local-fixture-import",
            "local-fixed-fixture"
          ]
        },
        "execution_authenticated": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "principal",
        "trust",
        "execution_authenticated"
      ],
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "observations_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "format",
    "project_id",
    "repo_id",
    "plan_ref",
    "stage_ref",
    "target",
    "base_source_ref",
    "result_tree_oid",
    "result_manifest_sha256",
    "acceptance_contract_sha256",
    "checker",
    "results",
    "regressions",
    "producer",
    "limitations",
    "observations_sha256"
  ],
  "additionalProperties": false
}
