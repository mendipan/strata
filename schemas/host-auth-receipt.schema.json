{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "strata-host-auth/1"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "model_version": {
      "type": "string",
      "const": "strata/0.3-block-lifecycle-experimental"
    },
    "principal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "principal_kind": {
      "type": "string",
      "enum": [
        "person",
        "agent"
      ]
    },
    "account_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "credential_epoch": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy_generation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "grant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "trust": {
      "type": "string",
      "const": "host-authenticated"
    }
  },
  "required": [
    "format",
    "project_id",
    "model_version",
    "principal_id",
    "principal_kind",
    "account_id",
    "credential_epoch",
    "action",
    "input_sha256",
    "request_sha256",
    "policy_generation",
    "grant_id",
    "expires_at",
    "trust"
  ],
  "additionalProperties": false
}
