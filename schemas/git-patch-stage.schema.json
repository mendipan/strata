{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "git-patch-stage/1"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "repo_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "plan_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
    },
    "patch": {
      "type": "string"
    },
    "patch_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "operations": {
      "minItems": 1,
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "before": {
            "type": "object",
            "properties": {
              "content": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "mode": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "100644",
                      "100755"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "content",
              "sha256",
              "mode"
            ],
            "additionalProperties": false
          },
          "after": {
            "type": "object",
            "properties": {
              "content": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "mode": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "100644",
                      "100755"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "content",
              "sha256",
              "mode"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "path",
          "before",
          "after"
        ],
        "additionalProperties": false
      }
    },
    "result_tree_oid": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "result_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "unchanged_outside_write_set": {
      "type": "boolean",
      "const": true
    },
    "base_index_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    }
  },
  "required": [
    "format",
    "project_id",
    "repo_id",
    "plan_ref",
    "patch",
    "patch_sha256",
    "operations",
    "result_tree_oid",
    "result_manifest_sha256",
    "unchanged_outside_write_set",
    "base_index_digest",
    "owner"
  ],
  "additionalProperties": false
}
