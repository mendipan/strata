{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "strata-revalidation-auth/1"
    },
    "model_version": {
      "type": "string",
      "const": "strata/0.1-facets-experimental"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "repo_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "attempt_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "bridge_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "action": {
      "type": "string",
      "enum": [
        "drift.revalidate",
        "revalidation.run",
        "revalidation.criterion-review"
      ]
    },
    "action_input": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "drift.revalidate"
            },
            "request": {
              "type": "object",
              "properties": {
                "review": {
                  "type": "object",
                  "properties": {
                    "ref": {
                      "type": "string",
                      "maxLength": 256,
                      "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "required": [
                    "ref",
                    "sha256"
                  ],
                  "additionalProperties": false
                },
                "basis_evidence": {
                  "type": "object",
                  "properties": {
                    "ref": {
                      "type": "string",
                      "maxLength": 256,
                      "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "required": [
                    "ref",
                    "sha256"
                  ],
                  "additionalProperties": false
                },
                "expected_observation_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "criterion_reviews": {
                  "maxItems": 256,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "criterion_ref": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      },
                      "accepted": {
                        "type": "boolean",
                        "const": true
                      },
                      "rationale": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      }
                    },
                    "required": [
                      "criterion_ref",
                      "accepted",
                      "rationale"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "review",
                "basis_evidence",
                "expected_observation_sha256",
                "criterion_reviews"
              ],
              "additionalProperties": false
            },
            "bridge_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "action",
            "request",
            "bridge_sha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "revalidation.run"
            },
            "attempt_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "bridge_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "checker_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "measured_input_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "action",
            "attempt_id",
            "bridge_sha256",
            "checker_sha256",
            "measured_input_sha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "revalidation.criterion-review"
            },
            "attempt_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "bridge_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "assertions": {
              "maxItems": 256,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "criterion_ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "accepted": {
                    "type": "boolean",
                    "const": true
                  },
                  "rationale": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "required": [
                  "criterion_ref",
                  "accepted",
                  "rationale"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "action",
            "attempt_id",
            "bridge_sha256",
            "assertions"
          ],
          "additionalProperties": false
        }
      ]
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "authority": {
      "type": "object",
      "properties": {
        "account_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "principal_kind": {
          "type": "string",
          "enum": [
            "person",
            "agent"
          ]
        },
        "credential_epoch": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "policy_generation": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "account_generation": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "accounts_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "grant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "grant_scope_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "repository_configuration_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "responsible_scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "required": [
        "account_id",
        "principal_id",
        "principal_kind",
        "credential_epoch",
        "policy_generation",
        "policy_sha256",
        "account_generation",
        "accounts_sha256",
        "grant_id",
        "grant_scope_sha256",
        "repository_configuration_sha256",
        "responsible_scope",
        "expires_at"
      ],
      "additionalProperties": false
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "trust": {
      "type": "string",
      "const": "host-authenticated"
    }
  },
  "required": [
    "format",
    "model_version",
    "project_id",
    "repo_id",
    "attempt_id",
    "bridge_sha256",
    "action",
    "action_input",
    "input_sha256",
    "request_sha256",
    "authority",
    "issued_at",
    "expires_at",
    "trust"
  ],
  "additionalProperties": false
}
