{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "mediation-receipt/2"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "model_version": {
      "type": "string",
      "const": "strata/0.3-block-lifecycle-experimental"
    },
    "packet_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
    },
    "basis_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "case_revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "action": {
      "type": "string",
      "enum": [
        "approve_selection",
        "defer",
        "request_context",
        "planning_direction"
      ]
    },
    "option_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "target": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "partition_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "principal": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "type": "string",
      "const": "host-authenticated"
    },
    "generation": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "grant_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "use_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "message": {
      "type": "string"
    },
    "auth_receipt": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
    }
  },
  "required": [
    "format",
    "project_id",
    "model_version",
    "packet_ref",
    "basis_ref",
    "case_id",
    "case_revision",
    "action",
    "option_id",
    "target",
    "partition_sha256",
    "principal",
    "origin",
    "generation",
    "created_at",
    "grant_ref",
    "use_ref",
    "message",
    "auth_receipt"
  ],
  "additionalProperties": false
}
