{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "selection-use/2"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "grant_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
    },
    "policy_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "case_revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "packet_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
    },
    "target": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "principal": {
      "type": "string",
      "minLength": 1
    },
    "configuration_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "model_version": {
      "type": "string",
      "const": "strata/0.3-block-lifecycle-experimental"
    },
    "auth_receipt": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
    }
  },
  "required": [
    "format",
    "project_id",
    "grant_ref",
    "policy_ref",
    "case_id",
    "case_revision",
    "packet_ref",
    "target",
    "principal",
    "configuration_sha256",
    "model_version",
    "auth_receipt"
  ],
  "additionalProperties": false
}
