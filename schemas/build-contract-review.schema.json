{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "strata-build-contract-review/1"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]{0,255}$"
    },
    "repository_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]{0,255}$"
    },
    "action": {
      "type": "string",
      "enum": [
        "repository.contract.import",
        "repository.contract.attach"
      ]
    },
    "subject_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewer": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]{0,255}$"
    },
    "authority": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "ref",
        "sha256"
      ],
      "additionalProperties": false
    },
    "auth_receipt": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "ref",
        "sha256"
      ],
      "additionalProperties": false
    },
    "accepted": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "format",
    "project_id",
    "repository_id",
    "action",
    "subject_sha256",
    "reviewer",
    "authority",
    "auth_receipt",
    "accepted"
  ],
  "additionalProperties": false
}
