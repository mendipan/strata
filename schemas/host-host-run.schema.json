{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "strata-host-run/1"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "model_version": {
      "type": "string",
      "const": "strata/0.3-block-lifecycle-experimental"
    },
    "candidate": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "realization": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
    },
    "profile": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "output_tree": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "checker_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fixture_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "oracle_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "producer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "results": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "fixture": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "passed": {
            "type": "boolean"
          }
        },
        "required": [
          "check",
          "version",
          "fixture",
          "passed"
        ],
        "additionalProperties": false
      }
    },
    "observations_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "auth_receipt": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
    },
    "trust": {
      "type": "string",
      "const": "host-measured"
    }
  },
  "required": [
    "format",
    "project_id",
    "model_version",
    "candidate",
    "realization",
    "profile",
    "output_tree",
    "checker_sha256",
    "fixture_sha256",
    "oracle_sha256",
    "profile_id",
    "producer",
    "results",
    "observations_sha256",
    "auth_receipt",
    "trust"
  ],
  "additionalProperties": false
}
