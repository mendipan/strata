{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "mediation-basis/2"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "model_version": {
      "type": "string",
      "const": "strata/0.3-block-lifecycle-experimental"
    },
    "composition_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
    },
    "baseline": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
    },
    "authority_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "input_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_sha256": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "case_revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 3
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "impact": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "type": "string"
    },
    "guardians": {
      "type": "array",
      "items": {}
    },
    "reports": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
      }
    },
    "report_generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "configuration_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "access_generation": {
      "type": "string",
      "minLength": 1
    },
    "policy_status": {
      "type": "string",
      "enum": [
        "unique",
        "unresolved"
      ]
    },
    "policy_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "grant_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "policy_reason": {
      "type": "string",
      "minLength": 1
    },
    "alternatives": {
      "minItems": 1,
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "selected": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
            }
          },
          "rejected": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
            }
          },
          "context_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "eligible": {
            "type": "boolean"
          },
          "diagnostics": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "details": {}
              },
              "required": [
                "code",
                "message"
              ],
              "additionalProperties": false
            }
          },
          "snapshot_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "dispositions": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
            }
          }
        },
        "required": [
          "id",
          "selected",
          "rejected",
          "context_sha256",
          "eligible",
          "diagnostics",
          "snapshot_sha256",
          "dispositions"
        ],
        "additionalProperties": false
      }
    },
    "auth_receipt": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+@[A-Za-z0-9_-]+$"
    }
  },
  "required": [
    "format",
    "project_id",
    "model_version",
    "composition_ref",
    "baseline",
    "authority_sha256",
    "input_fingerprint",
    "source_sha256",
    "case_id",
    "case_revision",
    "supersedes",
    "expires_at",
    "goal",
    "impact",
    "scope",
    "guardians",
    "reports",
    "report_generation",
    "configuration_sha256",
    "access_generation",
    "policy_status",
    "policy_ref",
    "grant_ref",
    "policy_reason",
    "alternatives",
    "auth_receipt"
  ],
  "additionalProperties": false
}
