r","method":"review","version":"1"}],"facet_handling":{},"facets":[],"item":"booking.reminder/acceptance.review","outputs":[{"digest":"021ce258a063939ca1f14944f333214ab8c2f69f273dbd13e46c0bb6b5e8d905","path":"booking.mjs"},{"digest":"20c35c7d4715c01a307370163e95949e47114d67d76fdc8c4858043d5e402045","path":"intent.json"},{"digest":"2d88f82d1182b535ba35ff14a6377420ce4eb0271811e317d2fdccd23e76c0ef","path":"README.md"}],"rationale":"The pinned booking template implements this recognized item; imported fixture evidence and explicit review remain required.","status":"implemented_validation_pending","subjects":["booking.reminder/purpose"]},{"capability":"bounded-booking-template","checks":[{"check":"booking.reminder","fixture":"timing","method":"mechanical","version":"1"}],"facet_handling":{},"facets":[],"item":"booking.reminder/acceptance.timing","outputs":[{"digest":"021ce258a063939ca1f14944f333214ab8c2f69f273dbd13e46c0bb6b5e8d905","path":"booking.mjs"},{"digest":"20c35c7d4715c01a307370163e95949e47114d67d76fdc8c4858043d5e402045","path":"intent.json"},{"digest":"2d88f82d1182b535ba35ff14a6377420ce4eb0271811e317d2fdccd23e76c0ef","path":"README.md"}],"rationale":"The pinned booking template implements this recognized item; imported fixture evidence and explicit review remain required.","status":"implemented_validation_pending","subjects":["booking.reminder/relationships.hold","booking.reminder/requirements.timing"]},{"capability":"command-line-and-explicit-review","checks":[{"check":"intent.review","fixture":"booking.reminder","method":"review","version":"1"}],"facet_handling":{},"facets":[],"item":"booking.reminder/purpose","outputs":[{"digest":"021ce258a063939ca1f14944f333214ab8c2f69f273dbd13e46c0bb6b5e8d905","path":"booking.mjs"},{"digest":"20c35c7d4715c01a307370163e95949e47114d67d76fdc8c4858043d5e402045","path":"intent.json"},{"digest":"2d88f82d1182b535ba35ff14a6377420ce4eb0271811e317d2fdccd23e76c0ef","path":"README.md"}],"rationale":"The pinned booking template implements this recognized item; imported fixture evidence and explicit review remain required.","status":"implemented_validation_pending","subjects":["booking.reminder/purpose"]}],"files":{"booking.mjs":"import { readFileSync, writeFileSync } from 'node:fs';\nimport { pathToFileURL } from 'node:url';\nexport const config = {\"seconds\":900,\"enabled\":true,\"lead_seconds\":60};\nexport function createBooking(initial = { now: 0, holds: {}, reminders: [] }) {\n  const state = structuredClone(initial);\n  function advance(seconds) {\n    if (!Number.isInteger(seconds) || seconds < 0) throw new Error('advance requires nonnegative integer seconds');\n    state.now += seconds;\n    for (const hold of Object.values(state.holds)) {\n      if (config.enabled && !hold.reminded && state.now >= hold.expires - config.lead_seconds && state.now < hold.expires) { hold.reminded = true; state.reminders.push({ resource: hold.resource, owner: hold.owner, at: state.now }); }\n      if (state.now >= hold.expires) delete state.holds[hold.resource];\n    }\n    return structuredClone(state);\n  }\n  function hold(resource, owner) {\n    if (typeof resource !== 'string' || !resource || typeof owner !== 'string' || !owner || ['__proto__', 'constructor', 'prototype'].includes(resource)) throw new Error('invalid hold request');\n    if (Object.hasOwn(state.holds, resource)) return { accepted: false, reason: 'occupied' };\n    state.holds[resource] = { resource, owner, expires: state.now + config.seconds, reminded: false };\n    return { accepted: true, expires: state.now + config.seconds };\n  }\n  return { hold, advance, state: () => structuredClone(state) };\n}\nif (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) {\n  try {\n    const args = process.argv.slice(2); const index = args.indexOf('--state-file');\n    if (index < 0 || !args[index + 1]) throw new Error('--state-file is required outside the realization output tree');\n    const file = args[index + 1]; args.splice(index, 2);\n    let initial; try { initial = JSON.parse(readFileSync(file, 'utf8')); } catch (e) { if (e.code !== 'ENOENT') throw e; }\n    const app = createBooking(initial); let result;\n    if (args[0] === 'hold' && args.length === 3) result = app.hold(args[1], args[2]);\n    else if (args[0] === 'advance' && args.length === 2) result = app.advance(Number(args[1]));\n    else if (args[0] === 'state' && args.length === 1) result = app.state();\n    else throw new Error('use hold resource owner, advance seconds, or state');\n    writeFileSync(file, JSON.stringify(app.state()) + '\\n');\n    process.stdout.write(JSON.stringify(result) + '\\n');\n  } catch (e) { process.stderr.write(e.message + '\\n'); process.exitCode = 2; }\n}\n","intent.json":"{\"enabled\":true,\"lead_seconds\":60,\"seconds\":900}\n","README.md":"Disposable local booking realization. Run node booking.mjs hold resource owner --state-file /path/to/runtime.json, then advance seconds or state. Keep runtime state outside this output tree.\n"},"model_version":"strata/0.1-facets-experimental","output_tree":"3562e8eb9c5e72090734235b1295e4e3e43911c29c0671e291d1ee97d83b3761","profile":"082c69b5420253378ae65ba450aa26be9e791921c50a9f7acca2a9c8345e13e5","profile_id":"booking-node/1","protocol_version":"1","reverse_links":{"booking.mjs":["app/acceptance.review","app/purpose","booking/acceptance.review","booking/purpose","booking.hold/requirements.exclusive","booking.hold/requirements.expiry","booking.hold/acceptance.exclusive","booking.hold/acceptance.expiry","booking.hold/acceptance.lifecycle","booking.hold/acceptance.review","booking.hold/contract.inputs.hold","booking.hold/contract.outputs.state","booking.hold/contract.failures.occupied","booking.hold/purpose","booking.reminder/requirements.timing","booking.reminder/relationships.hold","booking.reminder/acceptance.layer-reminder","booking.reminder/acceptance.once","booking.reminder/acceptance.review","booking.reminder/acceptance.timing","booking.reminder/p